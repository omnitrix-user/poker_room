# Copy to .env (or set in your host's dashboard). Never commit real values.

# Required in production: 32+ random characters. Encrypts live-game snapshots and stored hole cards.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Postgres connection string. Leave unset to use the embedded database in DATA_DIR.
# Append ?sslmode=require for managed Postgres that needs TLS.
DATABASE_URL=

# Embedded database location (used only when DATABASE_URL is unset). Put it on a persistent volume.
DATA_DIR=.data/pglite

# HTTP + WebSocket port.
PORT=3001

# Seconds a disconnected player keeps their turn before being checked/folded.
RECONNECT_GRACE_SECONDS=30

# Pause between hands, in milliseconds.
HAND_PAUSE_MS=5000

# Extra pause after an all-in runout (clients reveal it street by street) and after a showdown.
RUNOUT_PAUSE_MS=6000
SHOWDOWN_PAUSE_MS=2500

# Set to 1 when running behind a reverse proxy / load balancer (for client IPs in rate limits).
TRUST_PROXY=0

# Only needed if the web app is served from a different origin than this server (comma-separated).
ALLOWED_ORIGINS=

# Max connections in the Postgres pool.
PG_POOL_MAX=10
