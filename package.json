{
  "name": "riverroom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build -w @riverroom/web && npm run build -w @riverroom/server",
    "start": "NODE_ENV=production node apps/server/dist/server.js",
    "serve": "WEB_DIST=apps/web/dist node apps/server/dist/server.js",
    "typecheck": "tsc -p packages/engine && tsc -p packages/protocol && tsc -p apps/server && tsc -p apps/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:postgres": "vitest run apps/server"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6"
  }
}
